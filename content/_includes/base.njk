{#- The one layout for every page.

    Order on every page: skip link, banner, the Main navigation bar, then the
    page. Article pages add two navigation landmarks before the article, in a
    left column: the article's contents, titled "Page Contents", and
    the list of articles. A page with contentsPanel: true in its front matter gets the
    left column with only the contents. The unstrung documentation pages set
    sidePanel: docs and get the contents and the list of documents, which
    comes from
    content/_data/unstrungDocs.js. The contents list is filled in by the
    "headings" transform in eleventy.config.js, which replaces the
    page-contents comment below.

    No panel has an aria-label. NVDA announces an unnamed one as
    "navigation landmark" followed by its first line, the visible title, so
    the title is heard once rather than twice. -#}
{#- content/articles/index.md, the /articles/ page, has the articles tag from
    its folder but excludes itself from collections: it is not an article. -#}
{%- set isArticle = tags and "articles" in tags and not eleventyExcludeFromCollections -%}
{%- set hasPanels = isArticle or contentsPanel or sidePanel -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if page.url == "/" %}eyesunstrung{% else %}{{ title }} | eyesunstrung{% endif %}</title>
    {%- if description %}
    <meta name="description" content="{{ description }}">
    {%- endif %}
    {#- A page that repeats another sets canonical in its front matter to the
        other's address, starting with a slash. Search engines then show that
        one. Readers never meet it. #}
    {%- if canonical %}
    <link rel="canonical" href="{{ siteUrl }}{{ canonical }}">
    {%- endif %}
    {#- The tags apps read to preview a shared link. Not on the 404 page. #}
    {%- if page.url != "/404.html" %}
    {% include "social-card.njk" %}
    {%- endif %}
    <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/header.css">
    <link rel="preload" href="/assets/fonts/atkinson-hyperlegible-next-latin.woff2" as="font" type="font/woff2" crossorigin>
    <script src="/assets/js/menu.js" defer></script>
  </head>
  <body>
    {#- Goes to the h1, the first thing in main, so it passes the side panels
        on pages that have them. Styled by assets/css/header.css. #}
    <a class="skip-link" href="#page-title" tabindex="0">Skip to main content</a>

    {% include "banner.njk" %}

    {% include "main-menu.njk" %}

    {%- if hasPanels %}
    <div class="panel-layout">
      <div class="side-panels">
        <!--page-contents-->
        {%- if isArticle %}
        <nav class="panel">
          <p class="panel-title">eyesunstrung Articles</p>
          <ul role="list">
            {#- The /articles/ page, with the Prompter's Notes. The panel is
                only on article pages, so this is never the current page. #}
            <li><a href="/articles/" title="All Articles">All Articles</a></li>
            {%- for article in collections.articles %}
            <li><a href="{{ article.url }}" title="{{ article.data.title }}"{% if page.url == article.url %} aria-current="page"{% endif %}>{{ article.data.title }}</a></li>
            {%- endfor %}
          </ul>
        </nav>
        {%- elif sidePanel == "docs" %}
        <nav class="panel">
          <p class="panel-title">unstrung Documentation</p>
          <ul role="list">
            {%- set aboutLabel = unstrungDocs.about.menuLabel if unstrungDocs.available else "About unstrung" %}
            <li><a href="/unstrung/docs/" title="{{ aboutLabel }}"{% if page.url == "/unstrung/docs/" %} aria-current="page"{% endif %}>{{ aboutLabel }}</a></li>
            {%- for doc in unstrungDocs.documents %}
            {%- set docUrl = "/unstrung/docs/" + doc.id + "/" %}
            <li><a href="{{ docUrl }}" title="{{ doc.menuLabel }}"{% if page.url == docUrl %} aria-current="page"{% endif %}>{{ doc.menuLabel }}</a></li>
            {%- endfor %}
          </ul>
        </nav>
        {%- endif %}
      </div>
      {#- The page column: main and the footer, so the slate line down its
          left edge runs to the bottom of the page and the footer's line spans
          only this column. Reading order is unchanged: panels, main, footer. #}
      <div class="page-column">
    {%- endif %}

      <main id="main-content">
        {#- tabindex="-1" lets the skip link, and the contents panel's first
            link, put focus on the heading. It adds no tab stop. Without it
            Safari scrolls to the heading but leaves focus where it was, so the
            next Tab starts again from the top of the page. #}
        <h1 id="page-title" tabindex="-1">{{ title }}</h1>
        {%- if isArticle %}
        <p class="article-date">Published <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
        {%- endif %}
        {{ content | safe }}
      </main>

      <footer class="site-footer">
        <p>Comments? Email <a href="mailto:feedback@eyesunstrung.vip">feedback at eyesunstrung.vip</a></p>
        <ul role="list">
          <li><a href="https://github.com/joeldodson/eyesunstrung">eyesunstrung on GitHub</a></li>
          <li><a href="https://github.com/joeldodson/unstrungApp">unstrungApp on GitHub</a></li>
        </ul>
        {#- The day this build was made; see "updated" in eleventy.config.js. #}
        <p>Site last updated <time datetime="{{ updated.iso }}">{{ updated.readable }}</time></p>
        <p>&copy; 2024&ndash;{{ year }} Joel Dodson</p>
      </footer>

    {%- if hasPanels %}
      </div>
    </div>
    {%- endif %}
  </body>
</html>
