{#- The one layout for every page.

    Order on every page: skip link, banner, the Main navigation bar, then the
    page. Article pages add two navigation landmarks before the article, in a
    left column: the article's contents, named by its h1, and the list of
    articles. A page with contentsPanel: true in its front matter gets the
    left column with only the contents. A page with sidePanel set gets the
    contents and the list named there: "unstrung" for the /unstrung/ page,
    "docs" for the unstrung documentation pages, whose list comes from
    content/_data/unstrungDocs.js. The contents list is filled in by the
    "headings" transform in eleventy.config.js, which replaces the
    page-contents comment below. -#}
{#- content/articles/index.md, the /articles/ page, has the articles tag from
    its folder but excludes itself from collections: it is not an article. -#}
{%- set isArticle = tags and "articles" in tags and not eleventyExcludeFromCollections -%}
{%- set hasPanels = isArticle or contentsPanel or sidePanel -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if page.url == "/" %}eyesunstrung{% else %}{{ title }} | eyesunstrung{% endif %}</title>
    {%- if description %}
    <meta name="description" content="{{ description }}">
    {%- endif %}
    <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/menu.css">
    <link rel="preload" href="/assets/fonts/atkinson-hyperlegible-next-latin.woff2" as="font" type="font/woff2" crossorigin>
    <script src="/assets/js/menu.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <a class="banner" href="/"><img src="/assets/images/banner.svg" alt="eyesunstrung" width="1200" height="240"></a>
    </header>

    {% include "main-menu.njk" %}

    {%- if hasPanels %}
    <div class="panel-layout">
      <div class="side-panels">
        <!--page-contents-->
        {%- if isArticle %}
        <nav class="panel" aria-label="Articles">
          <p class="panel-title">Articles</p>
          <ul role="list">
            {%- for article in collections.articles %}
            <li><a href="{{ article.url }}" title="{{ article.data.title }}"{% if page.url == article.url %} aria-current="page"{% endif %}>{{ article.data.title }}</a></li>
            {%- endfor %}
          </ul>
        </nav>
        {%- elif sidePanel == "unstrung" %}
        <nav class="panel" aria-label="unstrung">
          <p class="panel-title">unstrung</p>
          <ul role="list">
            {%- for item in [
              { url: "/unstrung/app/", label: "The unstrung app" },
              { url: "/unstrung/docs/", label: "Documentation" },
              { url: "/unstrung/videos/", label: "Videos" }
            ] %}
            <li><a href="{{ item.url }}" title="{{ item.label }}">{{ item.label }}</a></li>
            {%- endfor %}
          </ul>
        </nav>
        {%- elif sidePanel == "docs" %}
        <nav class="panel" aria-label="Documentation">
          <p class="panel-title">Documentation</p>
          <ul role="list">
            {%- set aboutLabel = unstrungDocs.about.menuLabel if unstrungDocs.available else "About unstrung" %}
            <li><a href="/unstrung/docs/" title="{{ aboutLabel }}"{% if page.url == "/unstrung/docs/" %} aria-current="page"{% endif %}>{{ aboutLabel }}</a></li>
            {%- for doc in unstrungDocs.documents %}
            {%- set docUrl = "/unstrung/docs/" + doc.id + "/" %}
            <li><a href="{{ docUrl }}" title="{{ doc.menuLabel }}"{% if page.url == docUrl %} aria-current="page"{% endif %}>{{ doc.menuLabel }}</a></li>
            {%- endfor %}
          </ul>
        </nav>
        {%- endif %}
      </div>
      {#- The page column: main and the footer, so the slate line down its
          left edge runs to the bottom of the page and the footer's line spans
          only this column. Reading order is unchanged: panels, main, footer. #}
      <div class="page-column">
    {%- endif %}

      <main id="main-content">
        <h1 id="page-title">{{ title }}</h1>
        {%- if isArticle %}
        <p class="article-date">Published <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
        {%- endif %}
        {{ content | safe }}
      </main>

      <footer class="site-footer">
        <p>Comments? Email <a href="mailto:feedback@eyesunstrung.vip">feedback at eyesunstrung.vip</a></p>
        <ul role="list">
          <li><a href="https://github.com/joeldodson/eyesunstrung">eyesunstrung on GitHub</a></li>
          <li><a href="https://github.com/joeldodson/unstrungApp">unstrungApp on GitHub</a></li>
        </ul>
        <p>&copy; 2024&ndash;{{ year }} Joel Dodson</p>
      </footer>

    {%- if hasPanels %}
      </div>
    </div>
    {%- endif %}
  </body>
</html>
